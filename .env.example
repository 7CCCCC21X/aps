# Telegram 机器人 Token（找 @BotFather 创建）
TELEGRAM_BOT_TOKEN=你的TG机器人Token

# 接收提醒的 chat_id（先部署后给机器人发 /id 获取）
# 群组为负数，超级群/话题群形如 -100xxxxxxxxxx
TELEGRAM_CHAT_ID=你的chat_id

# 可选：群组话题(forum topic)的 id。设置后提醒只发到该话题
# 在目标话题里给机器人发 /id 即可获取 Topic ID
# TELEGRAM_TOPIC_ID=话题id

# 查询间隔（秒），最小 10
POLL_INTERVAL_SEC=60

# 本轮变化（两次查询之间）超过该百分比时提醒
POLL_ALERT_PERCENT=1

# 24H 涨跌超过该百分比时提醒（边沿触发：穿越阈值才报）
DAY_ALERT_PERCENT=5

# 24H 回滞阈值：回落到此值内才允许下一次触发，避免在阈值附近抖动反复报
# 默认 = DAY_ALERT_PERCENT - 1
# DAY_REARM_PERCENT=4

# 同一项目提醒的冷却时间（分钟）
ALERT_COOLDOWN_MIN=30

# 冷却作用域：project=同项目任意原因共用一个冷却（默认）；type=本轮/24H 各自独立
# COOLDOWN_SCOPE=project

# 本轮变化的回看窗口（秒）。0 = 对比上一次轮询；
# 设为 300 则对比“近 5 分钟”的价格，能抓到慢涨累积的异动
POLL_LOOKBACK_SEC=0

# 可选：有权执行写类命令（订阅/暂停/改阈值）的用户 id，逗号分隔；留空=不限制
# 给机器人发 /id 或用 @userinfobot 获取你的用户 id
# TELEGRAM_ADMIN_USER_IDS=123456789,987654321

# 可选：持久化文件路径（订阅 + 运行时设置）。指向 Railway Volume 可跨重新部署保留
# DATA_FILE=/data/data.json

# 即将上市（pre_launch）项目监控
# UPCOMING_ENABLED=true            # 设为 false 关闭
# UPCOMING_INTERVAL_SEC=300        # 检查间隔（秒，最小 60）
# LAUNCH_SOON_MIN=60               # 开盘前多少分钟内提醒“即将开盘”
# TRADING_CONFIG_ID=1              # 交易配置 id（assets-list 用）

# 可选：若 Aspecta 接口返回 401/403，填入登录后的 Cookie
# ASPECTA_COOKIE=你的cookie

# 可选：HTTP 端口（Railway 会自动注入 PORT）
# PORT=3000
